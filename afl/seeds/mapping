program t.aleo;

mapping m:
 key as u8.public;
 value as u8.public;

function a:
 input r0 as u8.public;
 input r1 as u8.public;
 async a r0 r1 into r2;
 output r2 as t.aleo/a.future;

finalize a:
 input r0 as u8.public;
 input r1 as u8.public;
 contains m[r0] into r2;
 assert.eq r2 false;
 set r1 into m[r0];
 contains m[r0] into r3;
 assert.eq r3 true;
 remove m[r0];
 contains m[r0] into r4;
 assert.eq r4 false;

function b:
 input r0 as u8.public;
 async b r0 into r1;
 output r1 as t.aleo/b.future;

finalize b:
 input r0 as u8.public;
 remove m[r0];
